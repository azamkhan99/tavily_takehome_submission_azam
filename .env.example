TAVILY_API_KEY=tvly-your-key-here
NEBIUS_API_KEY=your-nebius-key-here

# --- Cost control (defaults to cheapest practical stack) ---
# NEBIUS_COST_PROFILE=budget
#   budget   → Qwen3-30B-A3B (text) + MiniCPM-V-4.5 (fast OCR)
#   balanced → Llama 3.3 70B (text) + MiniCPM-V-4.5 (fast OCR)
#   quality  → Kimi K2.6 (text) + MiniCPM-V-4.5 (fast OCR)
# Override individual models if needed:
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# NEBIUS_VISION_MODEL=openbmb/MiniCPM-V-4_5
